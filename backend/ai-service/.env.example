# Application
PORT=8004
API_PREFIX=/api/v1

# LLM provider selection: "ollama" (local, default), "anthropic", or "openai".
# "openai" works with ANY OpenAI-compatible endpoint (OpenAI, Google Gemini,
# Groq, Together, Mistral, ...) — just point OPENAI_BASE_URL at it.
LLM_PROVIDER=ollama

# Ollama configuration (LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Anthropic configuration (LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible configuration (LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Example — Google Gemini via its OpenAI-compatible endpoint:
# OPENAI_API_KEY=<your Gemini API key>
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# CORS
CORS_ORIGIN=http://localhost:3000

# Generation defaults
MAX_TOKENS=512
TEMPERATURE=0.7
