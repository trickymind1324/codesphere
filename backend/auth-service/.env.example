# Auth Service Environment Variables
#
# The auth-service is a stateless registration/login proxy in front of
# Keycloak — it has no database, no JWT keys, and no OAuth/email config of
# its own. Identity, tokens, password reset, and MFA are all Keycloak's job.

# Server
NODE_ENV=development
PORT=3001

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:3000

# Keycloak (admin API is used to register users in the realm)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=codesphere
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
